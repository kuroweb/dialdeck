# Apple clangd が解釈できない Xtensa / GCC のフラグだけ外す。
# 診断は firmware/main の手書きソースだけ。生成フォントと ESP-IDF は出さない。
CompileFlags:
  CompilationDatabase: firmware/build
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=all
    - -fno-malloc-dce

---
If:
  PathExclude: .*/firmware/main/.*
Diagnostics:
  Suppress: "*"
Index:
  Background: Skip

---
If:
  PathMatch: .*/firmware/main/fonts/font_ja_16\.c
Diagnostics:
  Suppress: "*"
Index:
  Background: Skip
